# Supabase Configuration
# Copy this file to .env.local and fill in your project credentials.
# Never commit .env.local to version control.

# Public (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: enable demo login button in the app
# Set NEXT_PUBLIC_DEMO_MODE=true and provide credentials to show the demo button
# NEXT_PUBLIC_DEMO_MODE=true
# NEXT_PUBLIC_DEMO_EMAIL=demo@onspot.app
# NEXT_PUBLIC_DEMO_PASSWORD=your-demo-password-here
